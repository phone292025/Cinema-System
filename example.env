# Copy this file to .env for local Docker Compose runs and fill every secret value.
# Keep .env private; it is intentionally ignored by git.

POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
TICKET_SECRET=

# Demo accounts are disabled by default. Enable only for local/demo environments.
DEMO_USERS_ENABLED=false
DEMO_ADMIN_EMAIL=admin@cinema.test
DEMO_ADMIN_PASSWORD=
DEMO_CUSTOMER_EMAIL=customer@cinema.test
DEMO_CUSTOMER_PASSWORD=

# Request limits for the credential and payment endpoints. Defaults are applied
# when these are unset; set RATE_LIMIT_ENABLED=false only for local load testing.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_PAYMENT_PER_MINUTE=30
# Enable only behind a proxy that overwrites X-Forwarded-For.
RATE_LIMIT_TRUST_FORWARDED_FOR=false
