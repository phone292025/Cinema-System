# Copy this file to .env for local Docker Compose runs and fill every secret value.
# Keep .env private; it is intentionally ignored by git.
#
# Generate the secrets with a password manager or, for example:
#   openssl rand -base64 48
# The backend refuses to start if JWT_SECRET or TICKET_SECRET is shorter than 32
# characters, looks like a placeholder, or has too little variety.

POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
TICKET_SECRET=

# Session lifetimes. The frontend refreshes the access token automatically.
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14

# Time zone used for business dates such as "today's sessions".
APP_TIME_ZONE=UTC

# Seed the sample movie catalog, cinema, hall and showtimes on startup.
# Compose defaults this to true; the application itself defaults to false.
SEED_CATALOG_ENABLED=true

# Demo accounts are disabled by default. Enable only for local/demo environments.
DEMO_USERS_ENABLED=false
DEMO_ADMIN_EMAIL=admin@cinema.test
DEMO_ADMIN_PASSWORD=
DEMO_CUSTOMER_EMAIL=customer@cinema.test
DEMO_CUSTOMER_PASSWORD=

# Booking rules.
BOOKING_LOCK_MINUTES=5
BOOKING_CANCEL_CUTOFF_HOURS=2
PRICING_PREMIUM_SURCHARGE=4.00

# Payments. The mock gateway powers the demo checkout; disable it anywhere real
# money is involved. POST /api/payments/webhook is only accepted when
# PAYMENT_WEBHOOK_SECRET is set; leave it blank to disable the webhook.
PAYMENT_MOCK_GATEWAY_ENABLED=true
PAYMENT_WEBHOOK_SECRET=

# Request limits for the credential and payment endpoints. Defaults are applied
# when these are unset; set RATE_LIMIT_ENABLED=false only for local load testing.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_PAYMENT_PER_MINUTE=30
# Enable only behind a proxy that overwrites X-Forwarded-For.
RATE_LIMIT_TRUST_FORWARDED_FOR=false

# Browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API URL the browser uses. Next.js inlines it at build time, so rebuild the
# frontend image (make rebuild) after changing it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# Running without Docker: start PostgreSQL and Redis yourself, export the values
# above plus the connection settings below, then run `./mvnw spring-boot:run` in
# backend/ and `npm run dev` in frontend/ (put NEXT_PUBLIC_API_BASE_URL in
# frontend/.env.local).
# DATABASE_URL=jdbc:postgresql://localhost:5432/cinema
# DATABASE_USERNAME=cinema
# DATABASE_PASSWORD=
# REDIS_HOST=localhost
# REDIS_PORT=6379
# PORT=8080
